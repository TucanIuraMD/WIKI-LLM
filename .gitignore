# Obsidian local workspace state
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Obsidian cache / generated files
.obsidian/cache/

# Local plugin runtime files
.obsidian/plugins/*/node_modules/
.obsidian/plugins/*/.git/

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.swp
*.bak

# --- Sensitive / private materials (never commit) ---
# databases, dumps, backups
db/
*.sql
*.dump
*.binlog
backup_*/
backups/

# secrets, keys, credentials
*.key
*.pem
*.hex
*.pfx
*.p12
.env
credentials*
*secret*
*credential*

# archives / original sources / audit material
*.zip
*.rar
*.7z
*.tar.gz
_audit/
audit/
internal/
